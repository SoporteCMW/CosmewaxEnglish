# Copia este archivo como `.env`.
# `.env` está en .gitignore y tiene prioridad sobre las variables de entorno del
# sistema, a propósito: nombres como ANTHROPIC_MODEL los definen otras
# herramientas y no deben cambiar en silencio el comportamiento de la app.

# ─────────────────────────────────────────────────────────────────────────────
# Proveedor de IA:  sidecar | anthropic
#
#   sidecar   → claude-sidecar interno (http://10.0.70.32:5060). SIN claves.
#               Solo funciona desde la red interna 10.0.x.x. Es el modo normal.
#   anthropic → API pública de Anthropic. Requiere ANTHROPIC_API_KEY.
# ─────────────────────────────────────────────────────────────────────────────
AI_PROVIDER=sidecar

# ── IA interna (claude-sidecar) ──────────────────────────────────────────────
# Servicio solo accesible desde la red interna 10.0.x.x. No requiere credenciales.
# Con IA_CLI=false la app funciona igual: Tarjetas y Gramática son 100% locales,
# y los modos que necesitan IA avisan en pantalla en lugar de fallar.
IA_CLI=true
IA_CLI_URL=http://10.0.70.32:5060/claude
IA_CLI_MODEL=claude-sonnet-4-6
IA_CLI_TIMEOUT=120

# ── API pública de Anthropic (solo si AI_PROVIDER=anthropic) ─────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# OJO con el formato del ID de modelo: guiones, no puntos.
#   claude-haiku-4-5   → el más barato   ($1 / $5 por millón de tokens)
#   claude-sonnet-5    → equilibrio      ($3 / $15)
#   claude-opus-5      → máxima calidad  ($5 / $25)
ANTHROPIC_MODEL=claude-haiku-4-5

# Modelo por tarea (vacío = usa el global). Solo aplica a AI_PROVIDER=anthropic.
MODEL_CONVERSATION=
MODEL_FEEDBACK=
MODEL_READING=

# Esfuerzo de razonamiento: low | medium | high | xhigh | max
# Se ignora automáticamente en modelos que no lo soportan (Haiku 4.5).
EFFORT_CONVERSATION=low
EFFORT_FEEDBACK=medium
EFFORT_READING=low

# ── Límites de la aplicación ─────────────────────────────────────────────────
# Peticiones por IP. Protege el servidor de IA, que lanza un proceso por llamada.
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=300

# Ponlo a 1 sólo en local para ver el detalle de los errores.
APP_DEBUG=0

# ── Active Directory (login por LDAP) ─────────────────────────────────────────
# El login hace un bind simple con UPN (usuario@AD_DOMAIN) contra AD_HOST.
# Requiere la extensión `ldap` de PHP activada en php.ini.
AD_HOST=cosmewax.local
AD_PORT=389
AD_DOMAIN=cosmewax.local
# Sólo informativo: el bind simple no lo usa.
AD_BASE_DN=DC=cosmewax,DC=local

# ── Aplicación ────────────────────────────────────────────────────────────────
# Nombre visible en la topbar y en el <title>.
APP_NAME=Cosmewax English
# LOGIN_ON=false salta el login por completo y entra directo. Sólo para
# desarrollo en local: sin login no hay usuario, y sin usuario el progreso se
# guarda contra la cuenta anónima compartida.
LOGIN_ON=true
# Badge de entorno en la topbar: Desarrollo | Staging | Producción
APP_ENVIRONMENT=Desarrollo

# ── Base de datos (SQL Server) ────────────────────────────────────────────────
# Autenticación integrada de Windows: se usa la identidad del proceso Apache, que
# debe ser una cuenta de dominio con permiso en el servidor. NO se pasan usuario
# ni contraseña; el driver ODBC los interpretaría como login SQL y una cuenta de
# dominio fallaría. Es el mismo patrón que el resto de proyectos de la casa.
#
# Si la BD no responde, la aplicación sigue arrancando: los catálogos caen a los
# JSON de `data/` y el progreso pasa a ser de sólo lectura en memoria.
DB_HOST_DEV=CMW0090
DB_NAME=CosmewaxEnglish
