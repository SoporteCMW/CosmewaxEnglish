# Copia este archivo como `.env` y rellena la clave.
# `.env` está en .gitignore: la clave NUNCA llega al navegador ni al repositorio.
#
# NOTA: `.env` tiene prioridad sobre las variables de entorno del sistema, a
# propósito. Nombres como ANTHROPIC_MODEL los definen otras herramientas y no
# deben poder cambiar en silencio a qué modelo llama esta aplicación.

ANTHROPIC_API_KEY=sk-ant-...

# Modelo global. OJO CON EL FORMATO DEL ID: guiones, no puntos.
#   claude-haiku-4-5   → el más barato y rápido  ($1 / $5 por millón de tokens)
#   claude-sonnet-5    → equilibrio              ($3 / $15)
#   claude-opus-5      → máxima calidad          ($5 / $25)
ANTHROPIC_MODEL=claude-haiku-4-5

# Modelo por tarea (vacío = usa el global). Útil para dejar la conversación en
# el modelo barato y subir sólo el feedback, que se genera una vez por llamada.
MODEL_CONVERSATION=
MODEL_FEEDBACK=
MODEL_READING=

# Esfuerzo de razonamiento: low | medium | high | xhigh | max
# Se ignora automáticamente en modelos que no lo soportan (Haiku 4.5).
EFFORT_CONVERSATION=low
EFFORT_FEEDBACK=medium
EFFORT_READING=low

# Límite de peticiones por IP (protege el gasto de API).
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=300

# Ponlo a 1 sólo en local para ver el detalle de los errores de API.
APP_DEBUG=0
